{
    "name": "starforge",
    "private": true,
    "type": "module",
    "workspaces": [
        "core",
        "client"
    ],
    "scripts": {
        "dev": "npm run dev -w client",
        "build": "npm run build -w client",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "prettier --check . && eslint . && tsc -p core --noEmit && tsc -b client",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.8.0",
        "prettier": "^3.9.6",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.0.0"
    }
}
